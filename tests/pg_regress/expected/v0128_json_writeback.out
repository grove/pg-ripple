-- ─── JWB-28: enable_json_writeback() succeeds for a still-rare (unpromoted)
-- predicate via vp_rare enqueue coverage (v0.129.0 C18-01 ENQUEUE-COVERAGE) ──
CREATE TABLE IF NOT EXISTS public.jwb_rare_coverage_test (
    item_id TEXT PRIMARY KEY,
    label   TEXT
);
SELECT pg_ripple.register_json_mapping(
    'jwb_rare_coverage',
    '{"item_id": "http://example.org/v0129/rare-id",
      "label":   "http://example.org/v0129/rare-label"}'::jsonb,
    NULL, NULL, NULL, NULL, NULL, NULL
);
 register_json_mapping 
-----------------------
 
(1 row)

UPDATE _pg_ripple.json_mappings
SET writeback_table        = 'jwb_rare_coverage_test',
    writeback_schema       = 'public',
    writeback_key_columns  = ARRAY['item_id'],
    writeback_conflict_policy = 'replace'
WHERE name = 'jwb_rare_coverage';
-- One ingest gives both predicates a dictionary entry; they stay in
-- vp_rare, well below vp_promotion_threshold.
SELECT pg_ripple.ingest_json(
    '{"item_id": "r001", "label": "Still rare"}'::jsonb,
    'https://example.com/v0129/rare/r001',
    'jwb_rare_coverage'
) AS jwb28_ingest;
 jwb28_ingest 
--------------
            2
(1 row)

DO $$
BEGIN
    PERFORM pg_ripple.enable_json_writeback('jwb_rare_coverage');
    RAISE NOTICE 'JWB-28 PASS: enable_json_writeback() succeeded for a still-rare predicate';
END;
$$;
SELECT writeback_enabled AS jwb28_writeback_enabled
FROM _pg_ripple.json_mappings
WHERE name = 'jwb_rare_coverage';
 jwb28_writeback_enabled 
-------------------------
 t
(1 row)

-- A further insert to the still-rare predicate should now auto-enqueue a
-- writeback event via the vp_rare trigger.
SELECT pg_ripple.ingest_json(
    '{"item_id": "r002", "label": "Also rare"}'::jsonb,
    'https://example.com/v0129/rare/r002',
    'jwb_rare_coverage'
) AS jwb28_ingest2;
 jwb28_ingest2 
---------------
             2
(1 row)

SELECT EXISTS(
    SELECT 1 FROM _pg_ripple.json_writeback_queue
    WHERE mapping_name = 'jwb_rare_coverage'
) AS jwb28_auto_enqueued;
 jwb28_auto_enqueued 
---------------------
 t
(1 row)

-- Must disable before dropping the mapping row: the vp_rare trigger this
-- test installed lives on a table shared by every predicate in the
-- database, so an orphaned trigger here (unlike one on a predicate's own
-- delta table) would break unrelated tests for the rest of the suite.
SELECT pg_ripple.disable_json_writeback('jwb_rare_coverage');
 disable_json_writeback 
------------------------
 
(1 row)

DELETE FROM _pg_ripple.json_mappings WHERE name = 'jwb_rare_coverage';
DROP TABLE IF EXISTS public.jwb_rare_coverage_test;
