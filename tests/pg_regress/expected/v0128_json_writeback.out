-- ─── JWB-26: missing writeback_key_columns value raises a descriptive error
-- (H18-02 / KEY-VALIDATION) — this is also the exact code path that used to
-- build a mis-numbered SQL placeholder when the 'error' conflict policy
-- pre-check filtered out an absent key column. ──────────────────────────────
CREATE TABLE IF NOT EXISTS public.jwb_partial_key_test (
    tenant_id TEXT,
    item_id   TEXT,
    label     TEXT,
    PRIMARY KEY (tenant_id, item_id)
);
SELECT pg_ripple.register_json_mapping(
    'jwb_partial_key',
    '{"tenant_id": "http://example.org/v0129/tenant-id",
      "item_id":   "http://example.org/v0129/item-id",
      "label":     "http://example.org/v0129/label"}'::jsonb,
    NULL, NULL, NULL, NULL, NULL, NULL
);
 register_json_mapping 
-----------------------
 
(1 row)

UPDATE _pg_ripple.json_mappings
SET writeback_table        = 'jwb_partial_key_test',
    writeback_schema       = 'public',
    writeback_key_columns  = ARRAY['tenant_id', 'item_id'],
    writeback_conflict_policy = 'error'
WHERE name = 'jwb_partial_key';
-- Only item_id and label are asserted — tenant_id is missing.
SELECT pg_ripple.ingest_json(
    '{"item_id": "sku-1", "label": "Widget"}'::jsonb,
    'https://example.com/v0129/partial/1',
    'jwb_partial_key'
) AS jwb26_ingest;
 jwb26_ingest 
--------------
            2
(1 row)

DO $$
BEGIN
    BEGIN
        PERFORM pg_ripple.writeback_json_row('jwb_partial_key', 'https://example.com/v0129/partial/1');
        RAISE EXCEPTION 'JWB-26 FAIL: expected a missing-key-column error';
    EXCEPTION WHEN OTHERS THEN
        IF SQLERRM LIKE '%PT0552%' AND SQLERRM LIKE '%tenant_id%' THEN
            RAISE NOTICE 'JWB-26 PASS: missing key column rejected: %', SQLERRM;
        ELSE
            RAISE EXCEPTION 'JWB-26 FAIL: unexpected error: %', SQLERRM;
        END IF;
    END;
END;
$$;
DELETE FROM _pg_ripple.json_mappings WHERE name = 'jwb_partial_key';
DROP TABLE IF EXISTS public.jwb_partial_key_test;
-- ─── JWB-27: conflict policy 'error' raises PT0551 when the row already
-- exists (H18-02) ────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS public.jwb_error_policy_test (
    contact_id TEXT PRIMARY KEY,
    full_name  TEXT
);
SELECT pg_ripple.register_json_mapping(
    'jwb_error_policy',
    '{"contact_id": "http://schema.org/identifier",
      "full_name":  "http://schema.org/name"}'::jsonb,
    NULL, NULL, NULL, NULL, NULL, NULL
);
