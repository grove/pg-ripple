-- v0.135.0: strict and governed prefix resolution.
LOAD '$libdir/pg_ripple';
WARNING:  pg_ripple: loaded without shared_preload_libraries; HTAP merge worker, CONSTRUCT writeback, and dictionary cache are disabled. Add pg_ripple to shared_preload_libraries in postgresql.conf.
\pset format unaligned
\pset tuples_only on
SELECT current_setting('pg_ripple.sparql_prefix_mode') = 'strict';
t
SELECT pg_ripple.load_ntriples(
    '<https://v0135-prefix.test/alice> <https://v0135-prefix.test/email> "alice@example.test" .'
) = 1;
t
SELECT pg_ripple.register_prefix('v135', 'https://v0135-prefix.test/');

DO $$
BEGIN
    PERFORM * FROM pg_ripple.sparql(
        'SELECT ?s WHERE { ?s v135:email ?o }'
    );
    RAISE EXCEPTION 'expected strict-prefix parse error';
EXCEPTION WHEN others THEN
    IF SQLERRM NOT LIKE '%SPARQL parse error%' THEN RAISE; END IF;
END
$$;
DO $$
BEGIN
    PERFORM pg_ripple.register_prefix('bad label', 'https://valid-v0135.test/');
    RAISE EXCEPTION 'expected PT0577 for invalid prefix label';
EXCEPTION WHEN others THEN
    IF SQLERRM NOT LIKE '%PT0577%' THEN RAISE; END IF;
END
$$;
SET pg_ripple.sparql_prefix_mode = 'registered';
SELECT count(*) = 1 FROM pg_ripple.sparql(
    'SELECT ?s WHERE { ?s v135:email ?o }'
);
t
SELECT count(*) = 0 FROM pg_ripple.sparql(
    'PREFIX v135: <https://other-v0135.test/> SELECT ?s WHERE { ?s v135:email ?o }'
);
t
SELECT pg_ripple.plan_cache_reset();

SELECT count(*) = 1 FROM pg_ripple.sparql(
    'SELECT ?s WHERE { ?s v135:email ?o }'
);
t
SELECT pg_ripple.register_prefix('v135_cache', 'https://cache-v0135.test/');

SELECT count(*) = 1 FROM pg_ripple.sparql(
    'SELECT ?s WHERE { ?s v135:email ?o }'
);
t
SELECT hits = 0 AND misses = 2 FROM pg_ripple.plan_cache_stats();
t
SELECT pg_ripple.prefix_registry_generation() AS generation_before \gset
BEGIN;
SELECT pg_ripple.register_prefix('v135_rollback', 'https://rollback-v0135.test/');

SELECT pg_ripple.prefix_registry_generation() > 0;
t
ROLLBACK;
SELECT pg_ripple.prefix_registry_generation() = :generation_before;
t
DO $$
BEGIN
    PERFORM pg_ripple.register_prefix('bad', 'not an iri');
    RAISE EXCEPTION 'expected PT0577';
EXCEPTION WHEN others THEN
    IF SQLERRM NOT LIKE '%PT0577%' THEN RAISE; END IF;
END
$$;
